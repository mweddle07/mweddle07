#Password strength checker
from getpass import getpass
print("Are you sure your password is strong enough?")
password = getpass("Enter your password: ")

score = 0

#length
if len(password) >= 12:
    score += 3
elif len(password) >= 8:
    score += 2
else:
    score += 1

#caps, numbers, or symbols?
has_upper = False
has_lower = False
has_number = False
has_symbol = False

symbols = "!@#$%^&*(/)-_=+{/}[]\|:;'<,>.?/`~"

for ch in password:
    if ch.isupper():
        has_upper = True
    elif ch.islower():
        has_lower = True 
    elif ch.isdigit():
        has_number = True
    elif ch in symbols:
        has_symbol = True 

if has_upper:
    score += 1
if has_lower:
    score += 1
if has_number:
    score += 1
if has_symbol:
    score += 1

#results
print("Results: ")
print("Length: ", len(password))
print("Uppercase: ", has_upper)
print("Lowercase: ", has_lower)
print("Number: ", has_number)
print("Symbol: ", has_symbol)
print("Total Score: ", score)

if score >= 7:
    print("Your password is strong")
elif score >= 5:
    print("Your password is good but could be better")
elif score >= 3:
    print("Your password isn't great and can use some work")
else:
    print("Your password SUCKS. Do better.")

if len(password) < 12:
    print("Try using 12+ characters")
if not has_upper:
    print("Try adding an uppercase letter")
if not has_lower:
    print("Try adding a lowercase letter")
if not has_number:
    print("Try adding a number")
if not has_symbol:
    print("Try adding a special character or symbol, such as ! or *")
